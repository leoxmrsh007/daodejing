{
  "title": "周易",
  "subtitle": "易经",
  "chapters": [
    {
      "chapter": 1,
      "title": "乾",
      "original": "乾：元亨利贞。",
      "gua_ci": "乾：元亨利贞。",
      "yao_ci": "初九：潜龙勿用。 九二：见龙在田，利见大人。 九三：君子终日乾乾，夕惕若厉，无咎。 九四：或跃在渊，无咎。 九五：飞龙在天，利见大人。 上九：亢龙有悔。 用九：见群龙无首，吉。",
      "wangbi_note": "乾者，健也。天之象也。六爻皆阳，纯阳之卦也。",
      "chengyi_note": "乾，天也，健也。纯阳之卦，君子法天而行健。",
      "zhuxi_note": "乾，卦之六爻，皆阳也。阳者，刚也，健也。",
      "modern_chinese": "（乾卦译文待补充）"
    },
    {
      "chapter": 2,
      "title": "坤",
      "original": "坤：元亨，利牝马之贞。君子有攸往，先迷后得主，利西南得朋，东北丧朋。安贞吉。",
      "gua_ci": "坤：元亨，利牝马之贞。君子有攸往，先迷后得主，利西南得朋，东北丧朋。安贞吉。",
      "yao_ci": "初六：履霜，坚冰至。 六二：直方大，不习无不利。 六三：含章可贞。或从王事，无成有终。 六四：括囊，无咎无誉。 六五：黄裳元吉。 上六：龙战于野，其血玄黄。 用六：利永贞。",
      "wangbi_note": "坤者，顺也。地之象也。六爻皆阴，纯阴之卦也。",
      "chengyi_note": "坤，地也，顺也。纯阴之卦，君子法地而行顺。",
      "zhuxi_note": "坤，卦之六爻，皆阴也。阴者，柔也，顺也。",
      "modern_chinese": "（坤卦译文待补充）"
    },
    {
      "chapter": 3,
      "title": "屯",
      "original": "屯：元亨利贞。勿用有攸往，利建侯。",
      "gua_ci": "屯：元亨利贞。勿用有攸往，利建侯。",
      "yao_ci": "初九：磐桓，利居贞，利建侯。 六二：屯如邅如，乘马班如。匪寇婚媾，女子贞不字，十年乃字。 六三：即鹿无虞，惟入于林中，君子几不如舍，往吝。 六四：乘马班如，求婚媾，往吉，无不利。 九五：屯其膏，小贞吉，大贞凶。 上六：乘马班如，泣血涟如。",
      "wangbi_note": "屯者，难也。物之始生，艰难之象也。",
      "chengyi_note": "屯，难也。万物始生，未得通畅，故为难也。",
      "zhuxi_note": "屯，下震上坎，震动坎险，动乎险中，故为屯难。",
      "modern_chinese": "（屯卦译文待补充）"
    },
    {
      "chapter": 4,
      "title": "蒙",
      "original": "蒙：亨。匪我求童蒙，童蒙求我。初筮告，再三渎，渎则不告。利贞。",
      "gua_ci": "蒙：亨。匪我求童蒙，童蒙求我。初筮告，再三渎，渎则不告。利贞。",
      "yao_ci": "初六：发蒙，利用刑人，用说桎梏，以往吝。 九二：包蒙吉，纳妇吉，子克家。 六三：勿用取女，见金夫，不有躬，无攸利。 六四：困蒙，吝。 六五：童蒙，吉。 上九：击蒙，不利为寇，利御寇。",
      "wangbi_note": "蒙者，稚也。物之幼稚，蒙昧之象也。",
      "chengyi_note": "蒙，稚也。物生必蒙，故受之以蒙。",
      "zhuxi_note": "蒙，下坎上艮，坎险艮止，险而止，故为蒙昧。",
      "modern_chinese": "（蒙卦译文待补充）"
    },
    {
      "chapter": 5,
      "title": "需",
      "original": "需：有孚，光亨，贞吉。利涉大川。",
      "gua_ci": "需：有孚，光亨，贞吉。利涉大川。",
      "yao_ci": "初九：需于郊，利用恒，无咎。 九二：需于沙，小有言，终吉。 九三：需于泥，致寇至。 六四：需于血，出自穴。 九五：需于酒食，贞吉。 上六：入于穴，有不速之客三人来，敬之终吉。",
      "wangbi_note": "需者，待也。有所待而后进之象也。",
      "chengyi_note": "需，待也。饮食之道，有待而后进。",
      "zhuxi_note": "需，下乾上坎，乾健坎险，健而陷，故为需待。",
      "modern_chinese": "（需卦译文待补充）"
    },
    {
      "chapter": 6,
      "title": "讼",
      "original": "讼：有孚窒惕，中吉，终凶。利见大人，不利涉大川。",
      "gua_ci": "讼：有孚窒惕，中吉，终凶。利见大人，不利涉大川。",
      "yao_ci": "初六：不永所事，小有言，终吉。 九二：不克讼，归而逋，其邑人三百户，无眚。 六三：食旧德，贞厉，终吉。或从王事，无成。 九四：不克讼，复即命，渝安贞，吉。 九五：讼元吉。 上九：或锡之鞶带，终朝三褫之。",
      "wangbi_note": "（讼卦注释待补充）",
      "chengyi_note": "（讼卦程颐注待补充）",
      "zhuxi_note": "（讼卦朱熹注待补充）",
      "modern_chinese": "（讼卦译文待补充）"
    },
    {
      "chapter": 7,
      "title": "师",
      "original": "师：贞，丈人吉，无咎。",
      "gua_ci": "师：贞，丈人吉，无咎。",
      "yao_ci": "初六：师出以律，否臧凶。 九二：在师中，吉无咎，王三锡命。 六三：师或舆尸，凶。 六四：师左次，无咎。 六五：田有禽，利执言，无咎。长子帅师，弟子舆尸，贞凶。 上六：大君有命，开国承家，小人勿用。",
      "wangbi_note": "（师卦注释待补充）",
      "chengyi_note": "（师卦程颐注待补充）",
      "zhuxi_note": "（师卦朱熹注待补充）",
      "modern_chinese": "（师卦译文待补充）"
    },
    {
      "chapter": 8,
      "title": "比",
      "original": "比：吉。原筮元永贞，无咎。不宁方来，后夫凶。",
      "gua_ci": "比：吉。原筮元永贞，无咎。不宁方来，后夫凶。",
      "yao_ci": "初六：有孚比之，无咎。有孚盈缶，终来有它，吉。 六二：比之自内，贞吉。 六三：比之匪人。 六四：外比之，贞吉。 九五：显比，王用三驱，失前禽。邑人不诫，吉。 上六：比之无首，凶。",
      "wangbi_note": "（比卦注释待补充）",
      "chengyi_note": "（比卦程颐注待补充）",
      "zhuxi_note": "（比卦朱熹注待补充）",
      "modern_chinese": "（比卦译文待补充）"
    },
    {
      "chapter": 9,
      "title": "小畜",
      "original": "小畜：亨。密云不雨，自我西郊。",
      "gua_ci": "小畜：亨。密云不雨，自我西郊。",
      "yao_ci": "初九：复自道，何其咎？吉。 九二：牵复，吉。 九三：舆说辐，夫妻反目。 六四：有孚，血去惕出，无咎。 九五：有孚挛如，富以其邻。 上九：既雨既处，尚德载，妇贞厉。月几望，君子征凶。",
      "wangbi_note": "（小畜卦注释待补充）",
      "chengyi_note": "（小畜卦程颐注待补充）",
      "zhuxi_note": "（小畜卦朱熹注待补充）",
      "modern_chinese": "（小畜卦译文待补充）"
    },
    {
      "chapter": 10,
      "title": "履",
      "original": "履：履虎尾，不咥人，亨。",
      "gua_ci": "履：履虎尾，不咥人，亨。",
      "yao_ci": "初九：素履，往无咎。 九二：履道坦坦，幽人贞吉。 六三：眇能视，跛能履，履虎尾，咥人，凶。武人为于大君。 九四：履虎尾，愬愬，终吉。 九五：夬履，贞厉。 上九：视履考祥，其旋元吉。",
      "wangbi_note": "（履卦注释待补充）",
      "chengyi_note": "（履卦程颐注待补充）",
      "zhuxi_note": "（履卦朱熹注待补充）",
      "modern_chinese": "（履卦译文待补充）"
    },
