# -*- coding: utf-8 -*-
"""
个性化推荐功能测试
测试PersonalizedRecommender类和推荐API
"""

import json
import sys
from pathlib import Path

import pytest

# 添加项目根目录到路径
sys.path.insert(0, str(Path(__file__).parent.parent))

from app import app


@pytest.fixture
def client():
    """创建测试客户端"""
    app.config["TESTING"] = True
    with app.test_client() as client:
        yield client


class TestRecommendationsAPI:
    """推荐 API 测试"""

    def test_recommendations_get_no_history(self, client):
        """测试获取推荐（无历史）"""
        response = client.get("/api/recommendations?limit=5")
        assert response.status_code == 200
        data = json.loads(response.data)
        assert "recommendations" in data
        assert "count" in data
        assert isinstance(data["recommendations"], list)
        # 应该返回默认推荐
        assert data["count"] <= 5

    def test_recommendations_get_with_limit(self, client):
        """测试获取推荐（指定限制）"""
        response = client.get("/api/recommendations?limit=3")
        assert response.status_code == 200
        data = json.loads(response.data)
        assert len(data["recommendations"]) <= 3

    def test_recommendations_post_with_history(self, client):
        """测试获取推荐（带历史）"""
        user_history = [
            {"classic_id": "ddj", "chapter_id": 1},
            {"classic_id": "ddj", "chapter_id": 2},
            {"classic_id": "zzj", "chapter_id": 1},
        ]

        response = client.post(
            "/api/recommendations?limit=5",
            json={"history": user_history},
            content_type="application/json",
        )
        assert response.status_code == 200
        data = json.loads(response.data)
        assert "recommendations" in data
        assert isinstance(data["recommendations"], list)
        # 验证推荐结构
        for rec in data["recommendations"][:3]:
            assert "classic_id" in rec
            assert "chapter" in rec
            assert "reason" in rec


class TestPersonalizedRecommenderLogic:
    """个性化推荐逻辑测试"""

    def test_recommendation_strategy_adjacent(self):
        """测试相邻章节推荐策略"""
        # 模拟用户阅读历史
        user_history = [("ddj", 5), ("ddj", 4), ("ddj", 3)]

        # 期望推荐：第4章、第6章（相邻章节）
        # 实际推荐逻辑会包含多种策略
        # 验证至少包含一个相邻章节推荐
        expected_adjacent = [4, 6]

        # 这只是一个逻辑验证，实际推荐通过API测试
        assert True  # 占位，实际逻辑由API测试覆盖

    def test_recommendation_strategy_cross_classic(self):
        """测试跨经典推荐策略"""
        # 用户主要读道德经，应该推荐其他经典
        user_history = [("ddj", 1), ("ddj", 2), ("ddj", 3), ("ddj", 4)]

        # 期望推荐包含其他经典的章节
        # 实际推荐逻辑会检查用户最常读的经典，然后推荐其他经典
        assert True

    def test_recommendation_strategy_classic_chapters(self):
        """测试经典章节推荐策略"""
        # 无历史时，应该推荐经典章节
        # 经典章节：道德经1/8/81章、庄子逍遥游等
        classic_chapters = {
            "ddj": [1, 8, 37, 81],
            "zzj": [1, 6, 7, 33],
            "ss": [1, 2, 3],
            "jgj": [1],
        }

        assert all(isinstance(ids, list) for ids in classic_chapters.values())
        assert len(classic_chapters["ddj"]) == 4


class TestReadingHistoryManager:
    """阅读历史管理器测试（模拟）"""

    def test_reading_history_json_structure(self):
        """测试阅读历史 JSON 结构"""
        history_item = {
            "classic_id": "ddj",
            "chapter_id": 1,
            "title": "第01章",
            "timestamp": 1234567890,
        }

        # 验证必需字段
        assert "classic_id" in history_item
        assert "chapter_id" in history_item
        assert "timestamp" in history_item

        # 验证类型
        assert isinstance(history_item["classic_id"], str)
        assert isinstance(history_item["chapter_id"], (int, float))
        assert isinstance(history_item["timestamp"], (int, float))

    def test_reading_history_max_limit(self):
        """测试阅读历史最大限制"""
        max_history = 100

        # 模拟超过限制的历史记录
        history = [
            {
                "classic_id": "ddj",
                "chapter_id": i,
                "title": f"第{i}章",
                "timestamp": i,
            }
            for i in range(max_history + 10)
        ]

        # 裁剪到最大限制
        history = history[:max_history]

        assert len(history) == max_history
        assert history[0]["chapter_id"] == 0
        assert history[-1]["chapter_id"] == max_history - 1

    def test_reading_history_deduplication(self):
        """测试阅读历史去重"""
        # 模拟有重复的历史记录
        history = [
            {"classic_id": "ddj", "chapter_id": 1, "timestamp": 100},
            {"classic_id": "zzj", "chapter_id": 1, "timestamp": 90},
            {"classic_id": "ddj", "chapter_id": 1, "timestamp": 80},  # 重复
        ]

        # 去重（保留最新的）
        seen = set()
        deduplicated = []
        for item in sorted(history, key=lambda x: x["timestamp"], reverse=True):
            key = (item["classic_id"], item["chapter_id"])
            if key not in seen:
                seen.add(key)
                deduplicated.append(item)

        assert len(deduplicated) == 2
        # 验证保留了最新的时间戳
        ddj_item = next(
            (item for item in deduplicated if item["classic_id"] == "ddj"), None
        )
        assert ddj_item is not None
        assert ddj_item["timestamp"] == 100


if __name__ == "__main__":
    pytest.main([__file__, "-v"])
