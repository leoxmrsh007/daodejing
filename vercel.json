{
  "version": 2,
  "public": true,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/daodejing",
      "destination": "/ddj/index.html"
    },
    {
      "source": "/daodejing/",
      "destination": "/ddj/index.html"
    },
    {
      "source": "/daodejing/chapter/:id",
      "destination": "/ddj/chapter:id.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
