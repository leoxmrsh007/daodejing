{
  "version": 2,
  "public": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/dist/index.html"
    },
    {
      "source": "/ddj",
      "destination": "/dist/ddj/index.html"
    },
    {
      "source": "/ddj/",
      "destination": "/dist/ddj/index.html"
    },
    {
      "source": "/ddj/chapter/:id",
      "destination": "/dist/ddj/chapter:id.html"
    },
    {
      "source": "/daodejing",
      "destination": "/dist/ddj/index.html"
    },
    {
      "source": "/daodejing/",
      "destination": "/dist/ddj/index.html"
    },
    {
      "source": "/daodejing/chapter/:id",
      "destination": "/dist/ddj/chapter:id.html"
    },
    {
      "source": "/(.*)",
      "destination": "/dist/$1"
    }
  ],
  "headers": [
    {
      "source": "/dist/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/dist/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
